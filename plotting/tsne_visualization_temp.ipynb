   "source": [
    "fig, (ax0, ax1, ax2) = plt.subplots(nrows=1, ncols=3, sharex=False,\n",
    "                                    figsize=(24, 6))\n",
    "\n",
    "M = 10000\n",
    "# Pretrained model\n",
    "tx_sub, ty_sub, y_test_sub = tx[:N], ty[:N], y_concat[:N]\n",
    "tx_sub, ty_sub, y_test_sub = tx_sub[:M], ty_sub[:M], y_test_sub[:M]\n",
    "\n",
    "plt.subplot(1, 3, 1)\n",
    "for i in range(num_classes):\n",
    "    y_i = y_test_sub == i\n",
    "    ax0.scatter(tx_sub[y_i[:]], ty_sub[y_i[:]], label=classes[i])\n",
    "    \n",
    "ax0.set_title('Pretrained model')\n",
    "ax0.legend(loc=4)\n",
    "\n",
    "# Victim model\n",
    "tx_sub, ty_sub, y_test_sub = tx[N:2*N], ty[N:2*N], y_concat[N:2*N]\n",
    "tx_sub, ty_sub, y_test_sub = tx_sub[:M], ty_sub[:M], y_test_sub[:M]\n",
    "\n",
    "plt.subplot(1, 3, 2)\n",
    "for i in range(num_classes):\n",
    "    y_i = y_test_sub == i\n",
    "    ax1.scatter(tx_sub[y_i[:]], ty_sub[y_i[:]], label=classes[i])\n",
    "    \n",
    "ax1.set_title('Victim model')\n",
    "ax1.legend(loc=4)\n",
    "\n",
    "# Thief model\n",
    "tx_sub, ty_sub, y_test_sub = tx[2*N:], ty[2*N:], y_concat[2*N:]\n",
    "tx_sub, ty_sub, y_test_sub = tx_sub[:M], ty_sub[:M], y_test_sub[:M]\n",
    "\n",
    "plt.subplot(1, 3, 3)\n",
    "for i in range(num_classes):\n",
    "    y_i = y_test_sub == i\n",
    "    ax2.scatter(tx_sub[y_i[:]], ty_sub[y_i[:]], label=classes[i])\n",
    "    \n",
    "ax2.set_title('Thief model')\n",
    "ax2.legend(loc=4)\n",
