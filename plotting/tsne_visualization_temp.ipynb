   "source": [
    "# Concatenate all features\n",
    "avgpool_concat = np.concatenate((avgpool_pretrained, avgpool_victim, avgpool_thief))\n",
    "y_concat = np.concatenate((y_pretrained, y_victim, y_thief))\n",
    "\n",
    "# avgpool_concat = avgpool_pretrained\n",
    "# y_concat = y_pretrained\n",
    "\n",
    "print(avgpool_concat.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# standardize features by removing mean and scaling to unit variance\n",
    "sc = StandardScaler()\n",
    "X_rs = avgpool_concat.copy()\n",
    "print(X_rs.shape)\n",
    "X_rs = sc.fit_transform(X_rs)\n",
    "\n",
    "# apply PCA\n",
    "pca = PCA(n_components=20, whiten=True)\n",
    "pca.fit(X_rs)\n",
    "\n",
    "# extract the explained variance\n",
    "explained_variance = pca.explained_variance_ratio_\n",
    "singular_values = pca.singular_values_\n",
    "\n",
    "# create an x for each component\n",
    "x = np.arange(1,len(explained_variance)+1)\n",
    "\n",
    "# plot the results\n",
    "plt.plot(x, explained_variance)\n",
    "plt.ylabel('Share of Variance Explained')\n",
    "plt.title(\"PCA explained variance plot\")\n",
    "plt.xlabel(\"Components\")\n",
    "plt.show()\n",
    "print(sum(explained_variance))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# tSNE embeddings\n",
    "tsne = TSNE(perplexity=50).fit_transform(X_rs)\n",
    "tx, ty = tsne[:,0], tsne[:,1]\n",
    "tx = (tx-np.min(tx)) / (np.max(tx) - np.min(tx))\n",
    "ty = (ty-np.min(ty)) / (np.max(ty) - np.min(ty))"
   ]
  },
